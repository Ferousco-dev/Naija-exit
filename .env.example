# ─── Frontend (build-time, baked into the JS bundle) ────────────────
# These are PUBLIC. Anything VITE_* ends up in the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_BAYSE_PUBLIC_KEY=pk_xxx
VITE_GROQ_API_KEY=
VITE_GEMINI_API_KEY=

# Optional: override where `vite dev` proxies /api
# VITE_DEV_API_TARGET=http://localhost:8080

# Optional: override the base URL the frontend uses for API calls.
# Leave unset in production so it uses same-origin /api.
# VITE_API_BASE_URL=/api

# ─── Backend (runtime, set in Cloud Run, NEVER VITE_* prefixed) ─────
# These are SECRET. They must NOT appear in the frontend bundle.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloud Run sets PORT=8080 automatically; override only for local dev.
# PORT=8080
